---
interface ImageGalleryProps {
    images?: string[];
    alt?: string;
    caption?: string;
    fit?: "cover" | "contain";
    interaction?: "controls" | "wheel" | "controls-wheel";
}

const { images = [], alt = "会社の写真", caption = "", fit = "cover", interaction = "controls" } = Astro.props as ImageGalleryProps;
---

<div class:list={["image-gallery", `image-gallery--${fit}`]} data-image-gallery data-interaction={interaction}>
    <div class="image-gallery__viewport">
        {images.length > 1 && interaction !== "wheel" && <button type="button" class="image-gallery__hit-area image-gallery__hit-area--prev" aria-label="前の画像"></button>}
        {images.length > 1 && interaction !== "wheel" && <button type="button" class="image-gallery__hit-area image-gallery__hit-area--next" aria-label="次の画像"></button>}

        {images.map((src: string, index: number) => (
            <figure
                class:list={['image-gallery__slide', { 'is-active': index === 0 }]}
                data-index={index}
                aria-hidden={index !== 0 ? 'true' : 'false'}
            >
                <img src={src} alt={alt} loading="lazy" />
                {caption && index === 0 && <figcaption>{caption}</figcaption>}
            </figure>
        ))}
    </div>

    {images.length > 1 && interaction !== "wheel" && (
        <div class="image-gallery__controls">
            <div class="image-gallery__dots" aria-label="画像一覧">
                {images.map((_: string, index: number) => (
                    <button
                        type="button"
                        class:list={['image-gallery__dot', { 'is-active': index === 0 }]}
                        aria-label={`${index + 1}枚目の画像`}
                        data-index={index}
                    />
                ))}
            </div>
        </div>
    )}
</div>

<script>
    const galleries = document.querySelectorAll<HTMLElement>('[data-image-gallery]');

    galleries.forEach((gallery: HTMLElement) => {
        const slides = Array.from(gallery.querySelectorAll<HTMLElement>('.image-gallery__slide'));
        if (slides.length < 2) return;

        const dots = Array.from(gallery.querySelectorAll<HTMLButtonElement>('.image-gallery__dot'));
        const prevButton = gallery.querySelector<HTMLButtonElement>('.image-gallery__hit-area--prev');
        const nextButton = gallery.querySelector<HTMLButtonElement>('.image-gallery__hit-area--next');
        const interaction = gallery.dataset.interaction;
        const wheelInteraction = interaction === 'wheel' || interaction === 'controls-wheel';

        let currentIndex = 0;
        let lastWheelChange = 0;

        const updateSlide = (nextIndex: number) => {
            currentIndex = (nextIndex + slides.length) % slides.length;

            slides.forEach((slide: HTMLElement, index: number) => {
                const isActive = index === currentIndex;
                slide.classList.toggle('is-active', isActive);
                slide.setAttribute('aria-hidden', String(!isActive));
            });

            dots.forEach((dot: HTMLButtonElement, index: number) => {
                dot.classList.toggle('is-active', index === currentIndex);
                dot.setAttribute('aria-current', index === currentIndex ? 'true' : 'false');
            });
        };

        prevButton?.addEventListener('click', () => updateSlide(currentIndex - 1));
        nextButton?.addEventListener('click', () => updateSlide(currentIndex + 1));
        dots.forEach((dot: HTMLButtonElement) => {
            dot.addEventListener('click', () => {
                updateSlide(Number(dot.dataset.index));
            });
        });

        if (wheelInteraction) {
            gallery.addEventListener('wheel', (event: WheelEvent) => {
                if (Math.abs(event.deltaY) < 10) return;
                event.preventDefault();

                const now = Date.now();
                if (now - lastWheelChange < 500) return;
                lastWheelChange = now;
                updateSlide(currentIndex + (event.deltaY > 0 ? 1 : -1));
            }, { passive: false });
            if (interaction === 'wheel') return;
        }

        if (interaction === 'controls-wheel') return;

        let autoPlay = window.setInterval(() => updateSlide(currentIndex + 1), 4000);

        gallery.addEventListener('mouseenter', () => window.clearInterval(autoPlay));
        gallery.addEventListener('mouseleave', () => {
            autoPlay = window.setInterval(() => updateSlide(currentIndex + 1), 4000);
        });
    });
</script>
